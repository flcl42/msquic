<Project>
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
    <_MsQuicEdgeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MsQuicEdgeRid>
    <_MsQuicEdgeRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_MsQuicEdgeRid>
    <_MsQuicEdgeRid Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and
      ('$(PlatformTarget)' == 'x86' or '$(PlatformTarget)' == 'x64' or '$(PlatformTarget)' == 'arm64')">win-$(PlatformTarget.ToLowerInvariant())</_MsQuicEdgeRid>
    <_MsQuicEdgeWindowsLibrary Condition="$(_MsQuicEdgeRid.StartsWith('win-'))">$(MSBuildThisFileDirectory)windows/$(_MsQuicEdgeRid)/msquic.dll</_MsQuicEdgeWindowsLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_MsQuicEdgeWindowsLibrary)' != ''">
    <RuntimeHostConfigurationOption Include="System.Net.Quic.AppLocalMsQuic" Value="true" />
    <!-- The runtime loads an absolute path beside the app, including for single-file and Native AOT. -->
    <None Include="$(_MsQuicEdgeWindowsLibrary)" Link="msquic.dll" TargetPath="msquic.dll"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="_MsQuicEdgeValidateWindows" BeforeTargets="PrepareForBuild" Condition="'$(_MsQuicEdgeWindowsLibrary)' != ''">
    <Error Condition="$([MSBuild]::VersionLessThan('$(TargetFrameworkVersion)', '10.0'))"
           Text="MsQuic.Edge requires .NET 10 or newer for app-local MsQuic on Windows." />
    <Error Condition="!Exists('$(_MsQuicEdgeWindowsLibrary)')"
           Text="MsQuic.Edge has no Windows library for '$(_MsQuicEdgeRid)'. Use win-x86, win-x64, or win-arm64." />
  </Target>

  <Target Name="_MsQuicEdgeRemoveRuntimePackLibrary" AfterTargets="ResolveRuntimePackAssets" Condition="'$(_MsQuicEdgeWindowsLibrary)' != ''">
    <ItemGroup>
      <_MsQuicEdgeRuntimePackLibrary Include="@(RuntimePackAsset)"
                                    Condition="'%(RuntimePackAsset.DestinationSubPath)' == 'msquic.dll'" />
      <RuntimePackAsset Remove="@(_MsQuicEdgeRuntimePackLibrary)" />
      <ReferenceCopyLocalPaths Remove="@(_MsQuicEdgeRuntimePackLibrary)" />
    </ItemGroup>
  </Target>
</Project>
