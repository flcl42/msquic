<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Nethermind.MsQuic</PackageId>
    <_MsQuicVersionHeader>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../inc/msquic.ver'))</_MsQuicVersionHeader>
    <_MsQuicMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_MsQuicVersionHeader)', '(?m)(?&lt;=^#define VER_MAJOR )[0-9]+').Value)</_MsQuicMajor>
    <_MsQuicMinor>$([System.Text.RegularExpressions.Regex]::Match('$(_MsQuicVersionHeader)', '(?m)(?&lt;=^#define VER_MINOR )[0-9]+').Value)</_MsQuicMinor>
    <_MsQuicPatch>$([System.Text.RegularExpressions.Regex]::Match('$(_MsQuicVersionHeader)', '(?m)(?&lt;=^#define VER_PATCH )[0-9]+').Value)</_MsQuicPatch>
    <_MsQuicRevision>$([System.Text.RegularExpressions.Regex]::Match('$(_MsQuicVersionHeader)', '(?m)(?&lt;=^#define VER_FORK_REVISION )[0-9]+').Value)</_MsQuicRevision>
    <Version>$(_MsQuicMajor).$(_MsQuicMinor).$(_MsQuicPatch).$(_MsQuicRevision)</Version>
    <Authors>MsQuic contributors</Authors>
    <Description>OpenSSL-backed MsQuic builds from the fork for System.Net.Quic.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/flcl42/msquic</PackageProjectUrl>
    <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>msquic quic openssl native</PackageTags>
    <NethermindMsQuicNativeDir Condition="'$(NethermindMsQuicNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/nethermind-msquic/native</NethermindMsQuicNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md;../../../LICENSE;../../../THIRD-PARTY-NOTICES" Pack="true" PackagePath="/" />
    <None Include="../../../submodules/openssl/LICENSE.txt" Pack="true" PackagePath="licenses/OpenSSL.txt" />
    <None Include="Nethermind.MsQuic.targets" Pack="true" PackagePath="buildTransitive/" />

    <!-- Windows uses an explicit app-local path instead of the host's native probing directories. -->
    <None Include="$(NethermindMsQuicNativeDir)/native-win-x86/msquic.dll" Pack="true" PackagePath="buildTransitive/windows/win-x86/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-win-x64/msquic.dll" Pack="true" PackagePath="buildTransitive/windows/win-x64/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-win-arm64/msquic.dll" Pack="true" PackagePath="buildTransitive/windows/win-arm64/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-x86/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-x86/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-x64/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-arm/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-arm/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-arm64/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-musl-x64/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-musl-x64/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-linux-musl-arm64/libmsquic.so.2" Pack="true" PackagePath="runtimes/linux-musl-arm64/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-osx-x64/libmsquic.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(NethermindMsQuicNativeDir)/native-osx-arm64/libmsquic.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>
</Project>
